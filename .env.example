# 复制为项目根目录 `.env` 后再填写真实值。
# 应用启动时会自动读取该文件，适用于 IDE 直接跑 main 和 `mvn spring-boot:run`。

# Spring profile，通常本地使用 dev
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=Asia/Shanghai

# 服务监听端口
SERVER_PORT=8081

# MySQL，本地 Docker Compose 默认使用 rag_system 数据库和 13306 端口
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:13306/rag_system?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Kafka，topic 会在应用启动时自动创建，无需再手工执行 kafka-topics.sh
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SPRING_KAFKA_TOPIC_PARTITIONS=1
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1

# MinIO，对象存储用于文件上传与解析链路
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=uploads
# 私人案件文档独立 bucket，应用启动时自动创建；不要与公开法典共用
MINIO_PRIVATE_BUCKET_NAME=private-uploads

# Elasticsearch。
# 本地自签名证书可用 https + trust-all=true；
# 生产环境务必改为 trust-all=false，并确保 JVM 信任该证书链。
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=https
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=true

# JWT_SECRET_KEY 必须是 Base64 字符串，可用 `openssl rand -base64 32` 生成
JWT_SECRET_KEY=XeJw0yUoFDJWSNbWYFVEIXGfO8XgHrQLrIkKci5J9eA=

# 首次启动创建管理员时临时打开，创建成功后应改回 false
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

# 注册模式：OPEN / INVITE_ONLY / CLOSED
APP_AUTH_REGISTRATION_MODE=INVITE_ONLY
APP_AUTH_INVITE_REQUIRED=true

# 前端来源白名单，多个域名用逗号分隔
SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# LLM 与 Embedding 提供方
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=

# 检索前意图识别：Jev / System-One 决策模型（不是聊天模型，只做结构化判断）
# 方案 A（国内推荐，默认）：腾讯云 EdgeOne Makers 的 Jev 网关
#   1. 腾讯云控制台 -> EdgeOne -> Makers -> Models -> API Key 创建 Key
#   2. 填入下面三项，model 固定为 @makers/jev
ALIYUN_DECISION_API_URL=https://ai-gateway.edgeone.link/v1/systemone
ALIYUN_DECISION_API_KEY=
ALIYUN_DECISION_API_MODEL=@makers/jev
# 方案 B：万维易源 JevK5（国内可直接注册，第三方开源模型）
#   ALIYUN_DECISION_API_URL=https://jev.showapi.com/v1/systemone
#   ALIYUN_DECISION_API_KEY=你的ShowAPI_appKey
#   ALIYUN_DECISION_API_MODEL=JevK5-V0.3
# 方案 C：TypeSafe 官方 API（需要官方账号/国际支付方式）
#   ALIYUN_DECISION_API_URL=https://api.typesafe.ai/v1/systemone
#   ALIYUN_DECISION_API_KEY=tsf_xxx
#   ALIYUN_DECISION_API_MODEL=jev-latest
# 留空 key 时不会发起网络请求，检索链路使用规则兜底，不影响正常问答
ALIYUN_DECISION_TIMEOUT_MS=2000
ALIYUN_DECISION_CONFIDENCE_THRESHOLD=0.85

# 日志等级，排障时可临时改为 DEBUG
LOG_LEVEL_APP=INFO

# 前端部署
DEPLOY_SERVER_HOST=
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_KEY=/absolute/path/to/deploy-key.pem
DEPLOY_TARGET_DIR=/home/www/lawRagSystem-front
DEPLOY_HEALTHCHECK_URL=http://localhost:9527
DEPLOY_HEALTHCHECK_TIMEOUT=15

# 微信支付相关配置
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/pay-callback
WX_PAY_REFUND_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/refund-callback
